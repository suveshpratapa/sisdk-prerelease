	cd /Users/supratap/silabs-stash/silabs-thread/util/third_party/openthread/build/cmake-tidy && $(MAKE) $(MAKESILENT) -f src/core/CMakeFiles/openthread-ftd.dir/build.make src/core/CMakeFiles/openthread-ftd.dir/utils/verhoeff_checksum.cpp.i
.PHONY : utils/verhoeff_checksum.cpp.i

utils/verhoeff_checksum.s: utils/verhoeff_checksum.cpp.s
.PHONY : utils/verhoeff_checksum.s

